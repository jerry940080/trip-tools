rules_version = '2';
// 旅行記帳・餐廳（測試版）的資料權限。
// 用法：Firebase 主控台 → Firestore Database → 規則 → 整段貼上 → 發布。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function tripPath(t) { return /databases/$(database)/documents/trips/$(t); }
    function isOwner(t) { return signedIn() && get(tripPath(t)).data.owner == request.auth.uid; }
    // 建立新的一趟：只有網站主人（IzuAtami-trip 這趟的主辦人）可以，避免陌生人用 Google 登入後亂建行程、佔掉免費額度或搶走行程代號
    function isSiteOwner() {
      return signedIn() && get(/databases/$(database)/documents/trips/IzuAtami-trip).data.owner == request.auth.uid;
    }
    function isMember(t) {
      return signedIn() && (exists(/databases/$(database)/documents/trips/$(t)/members/$(request.auth.uid)) || isOwner(t));
    }

    // 記帳的 vis 要包含記帳的人、付錢的人、每個有分到的人
    function visOk(d) {
      return d.vis is list && d.vis.hasAll([d.by, d.payer]) && d.vis.hasAll(d.shares.keys());
    }

    // 每個人自己的「我加入了哪些行程」清單
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /trips/{t} {
      // 還沒建立的行程（resource == null）可以查，才知道能不能建立
      allow get: if signedIn() && (resource == null || isMember(t));
      allow list: if false;
      allow create: if isSiteOwner() && request.resource.data.owner == request.auth.uid;
      // 成員只能改匯率；主辦人可以改其他欄位，但不能把主辦人換掉
      allow update: if isMember(t)
        && request.resource.data.owner == resource.data.owner
        && (isOwner(t) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rate']));
      allow delete: if isOwner(t);

      // 邀請碼：只有主辦人看得到、改得到
      match /private/{doc} {
        allow read, write: if isOwner(t);
      }

      // 成員：自己加自己；不是主辦人的話，要帶有效（沒過期）的邀請碼
      match /members/{uid} {
        allow read: if isMember(t);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && (
            (isOwner(t) && request.resource.data.role == 'owner')
            || (request.resource.data.role == 'member'
                && request.resource.data.key == get(/databases/$(database)/documents/trips/$(t)/private/invite).data.key
                && request.time < get(/databases/$(database)/documents/trips/$(t)/private/invite).data.expires)
          );
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('key', null) == resource.data.get('key', null);
        allow delete: if isOwner(t) || (signedIn() && request.auth.uid == uid);
      }

      // 記帳：每筆有 vis（看得到的人＝記帳的人＋付錢的人＋有分到的人），只有 vis 裡的人讀得到。
      // 自己一個人的花費 vis 只有自己，別人（包括主辦人）都看不到。
      // 只有記帳的人或主辦人能改、能刪，而且自己要在 vis 裡（主辦人也改不到沒分到的帳）。
      match /expenses/{e} {
        allow read: if isMember(t) && request.auth.uid in resource.data.vis;
        allow create: if isMember(t) && request.resource.data.by == request.auth.uid && visOk(request.resource.data);
        allow update: if isMember(t) && request.auth.uid in resource.data.vis
          && (resource.data.by == request.auth.uid || isOwner(t))
          && request.resource.data.by == resource.data.by
          && visOk(request.resource.data);
        allow delete: if isMember(t) && request.auth.uid in resource.data.vis
          && (resource.data.by == request.auth.uid || isOwner(t));
      }

      // 預算（出發前的預估）：成員看得到，只有主辦人能改
      match /budget/{b} {
        allow read: if isMember(t);
        allow write: if isOwner(t);
      }

      // 已付的轉帳：只有轉帳的兩個人（vis）看得到；兩個人都能記、都能取消
      match /settles/{s} {
        allow read: if isMember(t) && request.auth.uid in resource.data.vis;
        allow create: if isMember(t) && request.resource.data.by == request.auth.uid
          && request.resource.data.vis is list
          && request.resource.data.vis.hasAll([request.resource.data.from, request.resource.data.to])
          && request.auth.uid in [request.resource.data.from, request.resource.data.to];
        allow delete: if isMember(t) && request.auth.uid in resource.data.vis;
      }

      // 私人照片（2026-11-16）：有家人朋友的照片不放公開的行程網站，存這裡（base64 WebP，每張 < 1 MiB）。
      // 成員看得到（回憶錄網站登入後讀這裡）、只有主辦人能新增／改卡片／刪除
      match /photos/{p} {
        allow read: if isMember(t);
        allow write: if isOwner(t);
      }

      // 排版（2026-11-17）：回憶錄網站每一頁的版型、放哪些照片／影片（只存編號）、標題與文字。
      // 任何人都讀得到（公開網站不登入也要照這個排；私人照片本身仍只有成員讀得到）、只有主辦人能寫
      match /pages/{p} {
        allow read: if true;
        allow write: if isOwner(t);
      }

      // 回憶錄私人媒體（2026-11-19）：壓縮好的照片、影片切成 512 KiB 的分塊。
      // 索引（media/{m}）與每一塊（media/{m}/chunks/{c}）都要各自寫規則——上層的規則不會套到子集合。
      // 成員讀得到（回憶錄網站登入後一塊一塊讀）、只有主辦人能上傳、改、刪
      match /media/{m} {
        allow read: if isMember(t);
        allow write: if isOwner(t);
        match /chunks/{c} {
          allow read: if isMember(t);
          allow write: if isOwner(t);
        }
      }

      // 書本版回憶錄的排版（2026-11-19）：每一頁放哪些照片影片（只存編號與順序）、用哪個版型。
      // 任何人都讀得到（公開的書不登入也要照這個排；私人照片本身仍只有成員讀得到）、只有主辦人能寫
      match /bookpages/{b} {
        allow read: if true;
        allow write: if isOwner(t);
      }

      // 回憶錄的私人文字（例如不想公開的經驗）：成員讀得到、只有主辦人能寫
      match /notes/{n} {
        allow read: if isMember(t);
        allow write: if isOwner(t);
      }

      // 餐廳：成員推薦（先進待收錄），只有主辦人能收錄／婉拒
      // 已收錄的店不用登入也讀得到：行程網站的「餐廳」頁會列出來（只有店名、日期、推薦人名字、備註）
      match /restos/{r} {
        allow read: if resource.data.status == 'in' || isMember(t);
        allow create: if isMember(t)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update: if isOwner(t);
        allow delete: if isOwner(t)
          || (isMember(t) && resource.data.by == request.auth.uid && resource.data.status == 'pending');
      }
    }
  }
}
